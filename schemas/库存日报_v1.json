{
  "_说明": "库存日报 —— 一个储位（库/罐）一行。化工厂场景的表型之一，仅作示例。",
  "template": "库存日报_v1",
  "sheet_label": "库存日报",
  "row_unit": "一行 = 一个储位（一个库位 / 一个罐）",

  "columns": [
    {"name": "日期", "type": "date", "required": true, "excel_format": "yyyy-mm-dd"},
    {"name": "位置", "type": "text", "required": true},
    {"name": "物料", "type": "text", "required": true}
  ],

  "measurements": {
    "enabled": true,
    "unit": "%",
    "categories": {
      "water": "never",
      "misc": "if_present"
    },
    "default_category": "always",
    "sum_max": 100.0
  },

  "vocabulary": {
    "water": ["水", "水分", "含水量", "水份", "含水"],
    "misc": ["杂", "杂质", "杂分", "其他", "残余", "不纯物"]
  },

  "fact_keys": {
    "record_date": "日期",
    "location": "位置",
    "material_name": "物料"
  },

  "archive": {
    "name_pattern": "{date}_{sheet}_第{n}张"
  }
}
