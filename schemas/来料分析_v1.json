{
  "_说明": "来料分析单 —— 一个样品/一桶一行。这是化工厂场景的表型之一，仅作示例；换别的行业请另建自己的 schema。",
  "template": "来料分析_v1",
  "sheet_label": "来料分析",
  "row_unit": "一行 = 一个样品（一个桶 / 一批）",

  "columns": [
    {"name": "日期", "type": "date", "required": true, "excel_format": "yyyy-mm-dd"},
    {"name": "位置", "type": "text"},
    {"name": "物料", "type": "text", "required": true},
    {"name": "批次", "type": "identifier"},
    {"name": "桶号", "type": "identifier"},
    {"name": "厂商", "type": "text"}
  ],

  "measurements": {
    "enabled": true,
    "unit": "%",
    "categories": {
      "water": "never",
      "misc": "if_present"
    },
    "default_category": "always",
    "sum_max": 100.0
  },

  "vocabulary": {
    "water": ["水", "水分", "含水量", "水份", "含水"],
    "misc": ["杂", "杂质", "杂分", "其他", "残余", "不纯物"]
  },

  "fact_keys": {
    "record_date": "日期",
    "location": "位置",
    "batch_id": "批次",
    "container_id": "桶号",
    "material_name": "物料",
    "supplier": "厂商"
  },

  "archive": {
    "name_pattern": "{date}_{sheet}_{batch}_第{n}张"
  }
}
